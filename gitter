#!/bin/bash

# Gitter CLI Wrapper Script
# Allows running gitter from project root without specifying build directory

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Look for gitter executable in build directories (in order of preference)
GITTER_EXEC=""

# Build directory patterns to search (in order of preference)
BUILD_DIRS=(
    "build/linux-release"
    "build/linux-debug"
    "build/linux-coverage"
    "build/macos-ninja-release"
    "build/macos-ninja-debug"
    "build/macos-release"
    "build/macos-debug"
    "build/windows-ninja-release"
    "build/windows-ninja-debug"
    "build/windows-release"
    "build/windows-debug"
    "build/windows-vs2022"
    "build/*"
)

# Search for gitter executable
for BUILD_DIR in "${BUILD_DIRS[@]}"; do
    # Handle wildcard patterns
    for SEARCH_DIR in "$SCRIPT_DIR"/$BUILD_DIR; do
        if [ -d "$SEARCH_DIR" ]; then
            # Try .exe first (Windows), then regular executable (Unix)
            if [ -f "$SEARCH_DIR/gitter.exe" ]; then
                GITTER_EXEC="$SEARCH_DIR/gitter.exe"
                break 2
            elif [ -f "$SEARCH_DIR/gitter" ] && [ -x "$SEARCH_DIR/gitter" ]; then
                GITTER_EXEC="$SEARCH_DIR/gitter"
                break 2
            fi
        fi
    done
done

# If no executable found, show error
if [ -z "$GITTER_EXEC" ]; then
    echo "Error: gitter executable not found." >&2
    echo "Please build the project first:" >&2
    echo "  cmake --preset linux-debug && cmake --build build/linux-debug" >&2
    echo "or:" >&2
    echo "  cmake --preset linux-release && cmake --build build/linux-release" >&2
    exit 1
fi

# Execute gitter with all arguments passed through
exec "$GITTER_EXEC" "$@"
